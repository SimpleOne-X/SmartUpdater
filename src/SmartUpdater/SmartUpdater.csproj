<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SimpleOneX.SmartUpdater</AssemblyName>
    <RootNamespace>SimpleOneX.SmartUpdater</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SimpleOneX.SmartUpdater</PackageId>
    <Version>10.0.1</Version>
    <Title>SimpleOneX.SmartUpdater</Title>
    <Authors>Andy Zhong</Authors>
    <Description>Windows 桌面应用的自动更新包。单包交付，零第三方依赖，AOT 兼容，标准用户账户可用。</Description>
    <RepositoryUrl>https://github.com/SimpleOne-X/SmartUpdater.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/SimpleOne-X/SmartUpdater</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>X-logo-128.png</PackageIcon>
    <PackageTags>autoupdate;updater;windows;aot</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Copyright>Copyright © 2026 SimpleOne-X</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/X-logo-128.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
