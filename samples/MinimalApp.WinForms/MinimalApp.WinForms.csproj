<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 根 Directory.Build.props 把 TargetFramework 写死为 net10.0；WinForms 必须覆盖成 -windows。
         项目文件在 props 之后求值，所以这里的覆盖生效。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SimpleOneX.SmartUpdater.Samples.WinForms</RootNamespace>
    <AssemblyName>MinimalApp.WinForms</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- 关掉 XML 文档：示例全是 internal 类型；开着的话升级包里会多一个 .xml。 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 保证 AssemblyInformationalVersion 恰好等于 -p:Version 给的字符串，不带 +提交哈希。 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- 默认版本；端到端脚本一律用 -p:Version=x.y.z 覆盖。 -->
    <Version>1.0.0</Version>
    <ApplicationIcon>../../assets/X-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 窗口图标：从嵌入资源加载，不依赖外部文件（升级包里也不会多出文件）。 -->
    <EmbeddedResource Include="../../assets/X-logo.ico" LogicalName="X-logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 唯一的第三方包，且只允许出现在这个 csproj 里。
         固定精确版本：2.4.7 / 2.4.9 已被作者 unlist，浮动版本会踩空。 -->
    <PackageReference Include="AntdUI" Version="2.4.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SmartUpdater/SmartUpdater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 示例把自己的 internal 类型开给自己的测试项目（与 SimpleOneX.SmartUpdater 的 InternalsVisibleTo 无关）。 -->
    <InternalsVisibleTo Include="MinimalApp.WinForms.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
